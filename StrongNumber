import java.util.Scanner;
public class StrongNumber {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        System.out.print("Enter the transaction code: ");
        int n = in.nextInt();
        int temp = n;
        int sum = 0;
        while (temp > 0) {
            int digit = temp % 10;
            int fact = 1;
            for (int i = 1; i <= digit; i++) {
                fact = fact * i;
            }
            sum = sum + fact;
            temp = temp / 10;
        }
        if (sum == n) {
            System.out.println("Special transaction (Strong number)");
        } else {
            System.out.println("Not a special transaction");
        }
      }
}
