import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
      Scanner input = new Scanner(System.in);
        int n = input.nextInt();
        int[] arr = new int[n];
        for (int i = 0; i < n; i++) {
            arr[i] = input.nextInt();
        }
        int product = 1;
        for (int i = 0; i < n; i++) {
            product = product * arr[i];
        }
      System.out.println(product);
    }
}
