import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
       Scanner input = new Scanner(System.in);
        int n = input.nextInt();
        int[] arr = new int[n];
        boolean[] visited = new boolean[n];
        for (int i = 0; i < n; i++) {
            arr[i] = input.nextInt();
        }
        for (int i = 0; i < n; i++) {
           if (visited[i]) {
                continue;
            }

            int count = 1;
         for (int j = i + 1; j < n; j++) {
               if (arr[i] == arr[j]) {
                    count++;
                    visited[j] = true;
                }
            }
       System.out.println(arr[i] + " occurs " + count + " times");
        }
    }
}
